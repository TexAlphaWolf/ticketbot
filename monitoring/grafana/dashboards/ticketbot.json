{
  "uid": "ticketbot",
  "title": "TicketBot",
  "tags": [
    "ticketbot",
    "discord"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "guild",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ticketbot-prometheus"
        },
        "query": {
          "query": "label_values(ticketbot_oldest_waiting_seconds, guild)",
          "refId": "guild"
        },
        "definition": "label_values(ticketbot_oldest_waiting_seconds, guild)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bot",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "ticketbot_bot_up",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "No heartbeat from the bot for 2 minutes: Offline"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open tickets",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum(ticketbot_open_tickets{guild=~\"$guild\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Longest wait for the staff",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "max(ticketbot_oldest_waiting_seconds{guild=~\"$guild\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "red",
                "value": 14400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Opened · 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum(ticketbot_tickets_opened_24h{guild=~\"$guild\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Closed · 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum(ticketbot_tickets_closed_24h{guild=~\"$guild\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Rating · 30 days",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "avg(ticketbot_rating_30d{guild=~\"$guild\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 1,
          "max": 5,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Open tickets by status",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum by (status) (ticketbot_open_tickets{guild=~\"$guild\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Open tickets by priority",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum by (priority) (ticketbot_open_tickets{guild=~\"$guild\"})",
          "legendFormat": "{{priority}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Average times · 7 days",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "avg(ticketbot_first_response_seconds_7d{guild=~\"$guild\"})",
          "legendFormat": "First answer"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "B",
          "expr": "avg(ticketbot_resolution_seconds_7d{guild=~\"$guild\"})",
          "legendFormat": "Resolution"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Escalated and waiting web actions",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum(ticketbot_escalated_open_tickets{guild=~\"$guild\"})",
          "legendFormat": "Escalated open tickets"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "B",
          "expr": "ticketbot_pending_web_actions",
          "legendFormat": "Dashboard actions waiting for the bot"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Bot latency to Discord",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "ticketbot_bot_latency_seconds",
          "legendFormat": "Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Web requests",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "sum by (route) (rate(ticketbot_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Web response time (95th percentile)",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketbot-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ticketbot-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ticketbot_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
