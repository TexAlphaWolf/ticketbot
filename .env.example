# Check this file with: python -m ticketbot settings (tokens are never printed)

DISCORD_TOKEN=paste_your_bot_token_here

# Required: key that encrypts the sensitive text in the database. Create it with
#   python -m ticketbot keygen
# and keep a copy somewhere safe: without it the encrypted data can't be read.
ENCRYPTION_KEY=
# Only while changing the key: the previous key(s), comma-separated
# ENCRYPTION_OLD_KEYS=

# Optional: Telegram bot token from @BotFather (enables Telegram notifications)
TELEGRAM_BOT_TOKEN=

# Optional: folder for the SQLite database and the backups (default: ./data)
# DATA_DIR=data

# Optional: use PostgreSQL instead of SQLite (the database must exist and be empty)
# DATABASE_URL=postgresql://ticketbot:password@localhost:5432/ticketbot

# Optional: automatic database backups (default: every 24 hours, keep the last 7)
# BACKUP_KEEP=7                # 0 disables automatic backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=data/backups

# Optional: web dashboard (python -m ticketbot web). By default only this computer can
# open it, at http://127.0.0.1:8080. To reach it from outside, put it behind HTTPS.
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# WEB_PUBLIC_URL=https://tickets.example.com
# WEB_API_DOCS=true            # interactive API docs at /api/docs
# WEB_TRUSTED_PROXIES=127.0.0.1
# WEB_SESSION_DAYS=7           # how long a login lasts

# Optional: login to the web dashboard with Discord. In the Developer Portal open your
# bot's application → OAuth2, copy the Client ID and reset/copy the Client Secret, and
# add this redirect (python -m ticketbot settings shows the exact address):
#   http://127.0.0.1:8080/api/v1/auth/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
